[Unit]
Description=Petpooja Order Dispatch Timer (3x daily)

[Timer]
# Breakfast: dispatch after 10pm IST deadline
OnCalendar=*-*-* 22:00:00
# Lunch: dispatch after 9:30am IST deadline
OnCalendar=*-*-* 09:30:00
# Dinner: dispatch after 5pm IST deadline
OnCalendar=*-*-* 17:00:00
Persistent=true

[Install]
WantedBy=timers.target
